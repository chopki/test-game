{
  "name": "hold-the-hall",
  "version": "0.1.0",
  "description": "A 3D browser tower-defence / survival game: wall in your Town Hall, raise towers, survive the waves.",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "bake": "node scripts/bake-sprites.mjs",
    "test:watch": "vitest",
    "test:e2e": "playwright test --grep @smoke",
    "test:e2e:full": "playwright test",
    "test:all": "vitest run && playwright test --grep @smoke",
    "test:full": "vitest run && playwright test"
  },
  "dependencies": {
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "vite": "^5.4.21",
    "vitest": "^2.1.9"
  }
}
